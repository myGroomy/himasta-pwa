# ============================================
# HIMASTA App - Environment Variables (Template)
# Salin ke .env dan .env.local lalu isi nilainya.
# ============================================

# NextAuth
NEXTAUTH_SECRET="random-long-string-min-32-char"
NEXTAUTH_URL="http://localhost:3000"

# --------------------------------------------
# SUPABASE DOCKER LOKAL VERSION (Default)
# --------------------------------------------
DATABASE_URL="postgresql://postgres:your-super-secret-and-long-postgres-password@127.0.0.1:54322/postgres?schema=public"
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --------------------------------------------
# SUPABASE CLOUD VERSION
# --------------------------------------------
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# NEXT_PUBLIC_SUPABASE_URL="https://[YOUR_PROJECT_REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-cloud-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-cloud-service-role-key"

