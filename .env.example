# ============================================
# HIMASTA App - Environment Variables (Template)
# Salin ke .env dan .env.local lalu isi nilainya.
# Nilai di bawah adalah default Supabase Docker LOKAL.
# Ganti dengan milikmu sendiri.
# ============================================

# Database (PostgreSQL via Supabase Docker Lokal)
# Port 54322 = akses langsung ke container postgres (bypass supavisor).
# Password = POSTGRES_PASSWORD di ~/supabase/docker/.env
DATABASE_URL="postgresql://postgres:your-super-secret-and-long-postgres-password@127.0.0.1:54322/postgres?schema=public"

# NextAuth
NEXTAUTH_SECRET="random-long-string-min-32-char"
NEXTAUTH_URL="http://localhost:3000"

# Supabase Storage (untuk upload dokumen)
# Key = ANON_KEY dan SERVICE_ROLE_KEY di ~/supabase/docker/.env
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
