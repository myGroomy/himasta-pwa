// Prisma Schema - HIMASTA App V1 → V3
// Sesuai dengan TDD.md, PRD_V3.md

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ANGGOTA
  KADIV
  BPH
  DOSEN
}

enum AnnouncementScope {
  GENERAL
  DIVISION
}

enum AnnouncementStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
}

enum DocumentCategory {
  NOTULEN
  PROPOSAL
  LPJ
  LAINNYA
}

enum ProkerStatus {
  RENCANA
  BERJALAN
  SELESAI
  DIBATALKAN
}

enum TaskStatus {
  BELUM
  BERJALAN
  SELESAI
}

enum PermissionStatus {
  PENDING
  DISETUJUI
  DITOLAK
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  REJECTED
}

enum EventVisibility {
  INTERNAL
  PUBLIC
}

enum MembershipStatus {
  AKTIF
  ALUMNI
  TIDAK_AKTIF
}

enum AttendanceStatus {
  HADIR
  IZIN
  TANPA_KETERANGAN
}

enum KegiatanCategory {
  RAPAT
  MAKRAB
  MUBES
  PROKER
  LAINNYA
}

// ============================================
// MODELS
// ============================================

model Division {
  id            String         @id @default(cuid())
  name          String         @unique   // BPH, PSDM, RION, PR, KOMINFO
  slug          String         @unique
  description   String?
  createdAt     DateTime       @default(now())

  users         User[]
  announcements Announcement[]
  documents     Document[]
  sessions      AttendanceSession[]
  prokers       Proker[]
  events        Event[]
  discussionThreads DiscussionThread[]
  memberHistories MemberHistory[]
}

model User {
  id             String    @id @default(cuid())
  nim            String?   @unique          // null untuk dosen
  email          String    @unique
  password       String                     // hashed dengan bcrypt
  name           String
  role           Role
  divisionId     String?
  division       Division? @relation(fields: [divisionId], references: [id])
  phone          String?
  photoUrl       String?
  isActive       Boolean   @default(true)
  pendingApproval Boolean  @default(false)   // true = registrasi baru menunggu persetujuan BPH
  qrToken        String?   @unique          // token QR pribadi untuk absensi (di-scan BPH/Kadiv)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  announcementsAuthored Announcement[]      @relation("AnnouncementAuthor")
  announcementsApproved Announcement[]      @relation("AnnouncementApprover")
  approvalLogs          ApprovalLog[]
  attendanceRecords     AttendanceRecord[]
  sessionsCreated       AttendanceSession[] @relation("SessionCreator")
  documentsUploaded     Document[]          @relation("DocumentUploader")
  notifications         Notification[]
  prokersProposed       Proker[]            @relation("ProkerProposer")
  prokersApproved       Proker[]            @relation("ProkerApprover")
  prokersLed            Proker[]            @relation("ProkerPj")
  tasksAssigned         Task[]
  permissionsRequested  Permission[]        @relation("PermissionRequester")
  permissionsApproved   Permission[]        @relation("PermissionApprover")
  eventsCreated         Event[]
  eventsApproved        Event[]             @relation("EventApprover")
  eventRegistrations    EventRegistration[]
  memberHistories       MemberHistory[]
  prokerEvaluations     ProkerEvaluation[]
  eventSurveys          EventSurvey[]
  feedbacksBPH          FeedbackBPH[]
  discussionThreads     DiscussionThread[]
  discussionReplies     DiscussionReply[]
}

model Announcement {
  id           String              @id @default(cuid())
  title        String
  content      String              @db.Text
  category     String              @default("organisasi") // event | beasiswa | akademik | organisasi
  scope        AnnouncementScope
  divisionId   String?             // wajib diisi jika scope = DIVISION
  division     Division?           @relation(fields: [divisionId], references: [id])
  status       AnnouncementStatus  @default(DRAFT)
  authorId     String
  author       User                @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  approvedById String?
  approvedBy   User?               @relation("AnnouncementApprover", fields: [approvedById], references: [id])
  rejectionReason String?          @db.Text   // alasan penolakan (wajib saat REJECTED)
  visibleToDosen Boolean           @default(false)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  publishedAt  DateTime?

  approvalLogs  ApprovalLog[]

  @@index([status, scope])
  @@index([divisionId])
  @@index([category])
}

model ApprovalLog {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  actorId        String
  actor          User         @relation(fields: [actorId], references: [id])
  action         String       // APPROVE | REJECT
  note           String?      @db.Text   // catatan saat approve / alasan reject
  createdAt      DateTime     @default(now())

  @@index([announcementId])
  @@index([actorId])
}

model AttendanceSession {
  id          String             @id @default(cuid())
  title       String             // contoh: "Rapat Mingguan RION #4"
  description String?            @db.Text
  category    KegiatanCategory   @default(RAPAT)   // Rapat | Makrab | Mubes | Proker | Lainnya
  divisionId  String?            // null jika sesi general/lintas divisi (scope organisasi)
  division    Division?          @relation(fields: [divisionId], references: [id])
  qrToken     String   @unique          // token unik untuk QR
  createdById String
  createdBy   User     @relation("SessionCreator", fields: [createdById], references: [id])
  startTime   DateTime
  endTime     DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  records     AttendanceRecord[]

  @@index([qrToken])
  @@index([divisionId, startTime])
}

model AttendanceRecord {
  id         String             @id @default(cuid())
  sessionId  String
  session    AttendanceSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id])
  status     AttendanceStatus   @default(HADIR)
  scannedAt  DateTime           @default(now())

  @@unique([sessionId, userId])   // 1 user hanya bisa absen 1x per sesi
  @@index([userId])
  @@index([sessionId])
}

model Document {
  id          String            @id @default(cuid())
  title       String
  description String?           @db.Text
  category    DocumentCategory
  fileUrl     String                    // path di Supabase Storage
  fileName    String                    // nama file original
  fileSize    Int?                      // dalam bytes
  mimeType    String?
  divisionId  String?                   // null jika dokumen general
  division    Division?         @relation(fields: [divisionId], references: [id])
  uploadedById String
  uploadedBy  User              @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([category, divisionId])
  @@index([uploadedById])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

// ============================================
// V2 PROGRAM KERJA, TASK, IZIN, EVENT
// ============================================

model Proker {
  id              String      @id @default(cuid())
  name            String
  description     String?     @db.Text
  status          ProkerStatus @default(RENCANA)
  timeline        String?                 // deskripsi ringkas timeline (misal "Mar–Mei 2026")
  startDate       DateTime?
  endDate         DateTime?
  estimateBudget  Decimal?    @db.Decimal(12, 2)
  actualBudget    Decimal?    @db.Decimal(12, 2)
  divisionId      String
  division        Division    @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  proposedById    String
  proposedBy      User        @relation("ProkerProposer", fields: [proposedById], references: [id])
  approvedById    String?
  approvedBy      User?       @relation("ProkerApprover", fields: [approvedById], references: [id])
  pjId            String?
  pj              User?       @relation("ProkerPj", fields: [pjId], references: [id])
  rejectedReason  String?     @db.Text
  approvedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  tasks           Task[]
  evaluation      ProkerEvaluation?

  @@index([divisionId, status])
  @@index([proposedById])
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?     @db.Text
  status      TaskStatus  @default(BELUM)
  prokerId    String
  proker      Proker      @relation(fields: [prokerId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?       @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([prokerId])
  @@index([assigneeId])
}

model Permission {
  id            String           @id @default(cuid())
  reason        String           @db.Text
  sessionTitle  String                      // kegiatan/rapat yang ditinggalkan
  sessionId     String?                     // optional link ke AttendanceSession
  startTime     DateTime?                   // waktu kegiatan (opsional)
  status        PermissionStatus @default(PENDING)
  requesterId   String
  requester     User             @relation("PermissionRequester", fields: [requesterId], references: [id])
  approvedById  String?
  approvedBy    User?            @relation("PermissionApprover", fields: [approvedById], references: [id])
  responseNote  String?          @db.Text   // catatan kadiv saat approve/reject
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())

  @@index([requesterId, status])
  @@index([sessionId])
}

model Event {
  id              String           @id @default(cuid())
  name            String
  description     String?          @db.Text
  startTime       DateTime
  endTime         DateTime?
  location        String?
  capacity        Int?
  visibility      EventVisibility  @default(INTERNAL)
  status          EventStatus      @default(DRAFT)
  divisionId      String?                    // null jika general/publik dibuat BPH
  division        Division?        @relation(fields: [divisionId], references: [id])
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])
  approvedById    String?
  approvedBy      User?            @relation("EventApprover", fields: [approvedById], references: [id])
  rejectedReason  String?          @db.Text
  approvedAt      DateTime?
  publishedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  registrations   EventRegistration[]
  surveys         EventSurvey[]

  @@index([divisionId, status])
  @@index([startTime])
}

model EventRegistration {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String?                      // null jika eksternal
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String                       // nama (auto dari user utk anggota)
  email      String?                      // wajib utk eksternal
  phone      String?
  institution String?                     // instansi / asal universitas
  qrToken    String?  @unique             // token absensi eksternal (jalur QR terpisah)
  attended   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
}

// ============================================
// V3 PERIODE, REGENERASI, EVALUASI, ANALYTICS
// ============================================

model Period {
  id          String    @id @default(cuid())
  name        String    @unique  // contoh: "2025/2026"
  isActive    Boolean   @default(false)
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  memberHistories  MemberHistory[]
  prokerEvaluations ProkerEvaluation[]
  feedbacksBPH      FeedbackBPH[]

  @@index([isActive])
}

model MemberHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodId   String
  period     Period   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  divisionId String?
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)
  role       Role
  status     MembershipStatus @default(AKTIF)
  joinedAt   DateTime @default(now())
  leftAt     DateTime?

  @@unique([userId, periodId])
  @@index([userId])
  @@index([periodId])
}

model ProkerEvaluation {
  id           String   @id @default(cuid())
  prokerId     String   @unique
  proker       Proker   @relation(fields: [prokerId], references: [id], onDelete: Cascade)
  periodId     String
  period       Period   @relation(fields: [periodId], references: [id])
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  whatWorked   String   @db.Text
  whatFailed   String   @db.Text
  lessons      String   @db.Text
  overallRating Int      // 1–5
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([prokerId])
  @@index([periodId])
}

model EventSurvey {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating    Int      // 1–5
  comment   String?  @db.Text
  isAnon    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])  // 1 user 1 survey per event
  @@index([eventId])
}

model FeedbackBPH {
  id        String   @id @default(cuid())
  content   String   @db.Text
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  isAnon    Boolean  @default(false)
  periodId  String
  period    Period   @relation(fields: [periodId], references: [id])
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([periodId, isRead])
}

model DiscussionThread {
  id         String   @id @default(cuid())
  title      String
  content    String   @db.Text
  divisionId String
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  replies    DiscussionReply[]

  @@index([divisionId])
  @@index([authorId])
}

model DiscussionReply {
  id        String          @id @default(cuid())
  threadId  String
  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String
  author    User             @relation(fields: [authorId], references: [id])
  content   String          @db.Text
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([threadId])
  @@index([authorId])
}
